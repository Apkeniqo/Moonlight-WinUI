<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MoonlightWinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>tools\assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 无 MSIX 打包，直接跑 exe；Windows App SDK 自带，不依赖机器上装了哪个运行时 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <!-- 版本号：项目根目录的 VERSION 文件是唯一来源，D:\Projects\moonlight-sync-build.ps1 也按它决定同步方向 -->
  <PropertyGroup>
    <VersionFile>$(MSBuildProjectDirectory)\VERSION</VersionFile>
    <Version Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</Version>
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <!-- 不把 git commit 塞进 ProductVersion，否则任务栏/属性里会显示 1.1.5+<hash> -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- 直接引用 Moonlight 仓库里预编译的 SDL2，用来验证原生 DLL 互操作 -->
  <ItemGroup>
    <None Include="SDL2.dll" Condition="Exists('SDL2.dll')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="SDL3.dll" Condition="Exists('SDL3.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- tools/ 下是安装器等独立工具，不参与本应用编译 -->
  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <!-- dist/ 是打包产物目录：绝不能作为资源复制进输出，否则会 dist→bin→dist 递归膨胀 -->
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <None Remove="dist\**" />
    <Page Remove="dist\**" />
    <PRIResource Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
  </ItemGroup>

  <!-- 窗口/任务栏图标：原版 moonlight.ico，复制到输出目录供 AppWindow.SetIcon 使用 -->
  <ItemGroup>
    <Content Include="tools\assets\app.ico" Link="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\assets\app.png" Link="app.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 原生解码/上屏 DLL + FFmpeg 运行时 + 测试片源 -->
  <ItemGroup>
    <None Include="native\mlrender.dll" Condition="Exists('native\mlrender.dll')" CopyToOutputDirectory="PreserveNewest" Link="mlrender.dll" />
    <!-- 配对收尾用的 HTTPS 客户端（OpenSSL，不依赖证书库） -->
    <None Include="native\pairtls.dll" Condition="Exists('native\pairtls.dll')" CopyToOutputDirectory="PreserveNewest" Link="pairtls.dll" />
    <None Include="test-1080p60.mp4" Condition="Exists('test-1080p60.mp4')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="test-1080p60.h264" Condition="Exists('test-1080p60.h264')" CopyToOutputDirectory="PreserveNewest" />
    <!-- 运行期 DLL（FFmpeg / OpenSSL / opus）统一放在 native\redist\x64\，随仓库同步；
         不再引用 Moonlight-Qt 仓库的绝对路径，两台机器同步后都能直接构建。
         升级 FFmpeg 时替换这个目录里的文件即可。 -->
    <None Include="native\redist\x64\*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- 客户端配对身份（Qt 版已配对；MS_Init 从这里读） -->
    <None Include="native\creds\client.crt" Condition="Exists('native\creds\client.crt')" CopyToOutputDirectory="PreserveNewest" Link="creds\client.crt" />
    <None Include="native\creds\client.key" Condition="Exists('native\creds\client.key')" CopyToOutputDirectory="PreserveNewest" Link="creds\client.key" />
    <None Include="native\creds\uniqueid.txt" Condition="Exists('native\creds\uniqueid.txt')" CopyToOutputDirectory="PreserveNewest" Link="creds\uniqueid.txt" />
  </ItemGroup>

</Project>
