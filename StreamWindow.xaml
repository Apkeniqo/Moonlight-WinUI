<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MoonlightWinUI.StreamWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MoonlightWinUI">

    <!-- 背景透明，让 Mica/Acrylic 透出来（和主界面同一套窗口材质） -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（拖拽区），材质由 SystemBackdrop 提供 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="16,0,140,0"
                        VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.9"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid x:Name="VideoArea" Grid.Row="1">
            <Border x:Name="VideoHost" Background="Black"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <SwapChainPanel x:Name="VideoPanel" IsTabStop="True"
                                KeyDown="VideoPanel_KeyDown" KeyUp="VideoPanel_KeyUp"
                                LostFocus="VideoPanel_LostFocus"
                                PointerPressed="VideoPanel_PointerPressed"
                                PointerReleased="VideoPanel_PointerReleased"
                                PointerMoved="VideoPanel_PointerMoved"
                                PointerCaptureLost="VideoPanel_PointerCaptureLost"
                                PointerWheelChanged="VideoPanel_PointerWheelChanged" />
            </Border>

            <!-- 断线重连：整屏半透明遮罩 + 中央进度 -->
            <Grid x:Name="ReconnectOverlay" Background="#B3000000" Visibility="Collapsed"
                  IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <ProgressRing x:Name="ReconnectRing" IsActive="False" Width="52" Height="52"
                                  HorizontalAlignment="Center" Foreground="#FFFFFFFF" />
                    <TextBlock x:Name="ReconnectText" FontSize="18" TextAlignment="Center"
                               Foreground="#FFFFFFFF" Text="连接中断，正在重新连接…" />
                    <TextBlock x:Name="ReconnectSubText" FontSize="13" TextAlignment="Center"
                               Foreground="#B3FFFFFF" Text="" />
                </StackPanel>
            </Grid>

            <!-- 连接/准备过程：画面正中；首帧到达后自动隐藏 -->
            <Border x:Name="StatusOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="26,18" CornerRadius="14" Background="#B3000000"
                    BorderBrush="#40FFFFFF" BorderThickness="1">
                <StackPanel Spacing="10">
                    <ProgressRing x:Name="ConnectRing" IsActive="True" Width="36" Height="36"
                                  HorizontalAlignment="Center" />
                    <TextBlock x:Name="StreamText" FontSize="13" TextAlignment="Center"
                               MaxWidth="420" TextWrapping="Wrap" Text="准备中…" />
                </StackPanel>
            </Border>
            <!-- 性能浮窗：顶部居中一行，不挡鼠标 -->
            <Border x:Name="PerfOverlay" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,12,0,0" Padding="16,8" CornerRadius="10"
                    Background="#B3000000" BorderBrush="#40FFFFFF" BorderThickness="1"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock x:Name="PerfFps" FontSize="13" Foreground="#FFFFFFFF" Text="— fps" />
                    <TextBlock x:Name="PerfCodec" FontSize="13" Foreground="#FFFFFFFF" Text="编解码 — / — ms" />
                    <TextBlock x:Name="PerfRtt" FontSize="13" Foreground="#FFFFFFFF" Text="网络 — ms" />
                    <TextBlock x:Name="PerfLoss" FontSize="13" Foreground="#FFFFFFFF" Text="丢包 —" />
                    <TextBlock x:Name="PerfBitrate" FontSize="13" Foreground="#FFFFFFFF" Text="— Mbps" />
                </StackPanel>
            </Border>

            <!-- 可拖动的悬浮按钮 + 传输控制浮层（都放在 Canvas 上，坐标由代码控制） -->
            <Canvas x:Name="OverlayCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border x:Name="ControlPanel" Width="320" Padding="16" CornerRadius="12"
                        Background="#F2000000" BorderBrush="#40FFFFFF" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="传输控制" FontSize="14" FontWeight="SemiBold" />
                        <ComboBox x:Name="ControlResolution" Header="分辨率" HorizontalAlignment="Stretch" />
                        <Slider x:Name="ControlBitrate" Header="码率（Mbps）" Minimum="5" Maximum="100"
                                StepFrequency="1" ValueChanged="ControlBitrate_ValueChanged" />
                        <TextBlock x:Name="ControlBitrateText" FontSize="12" Opacity="0.7" />
                        <Button x:Name="ControlFullScreenButton" Content="全屏" Click="ControlFullScreenButton_Click" />
                        <TextBlock x:Name="ControlStatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Content="应用" Click="ControlApply_Click" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="关闭" Click="ControlClose_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 客户端自己画的光标（Parsec 式：主机不再画，形状由 LI_CURSOR_UPDATE 驱动） -->
                <Image x:Name="CursorImage" Visibility="Collapsed" IsHitTestVisible="False"
                       Stretch="Fill" Width="32" Height="32" />

                <Border x:Name="ControlButton" Width="40" Height="40" CornerRadius="20"
                        Background="#73000000" BorderBrush="#40FFFFFF" BorderThickness="1"
                        Opacity="0.8"
                        ToolTipService.ToolTip="传输控制（左键按住可拖动）"
                        PointerPressed="ControlButton_PointerPressed"
                        PointerMoved="ControlButton_PointerMoved"
                        PointerReleased="ControlButton_PointerReleased"
                        PointerCaptureLost="ControlButton_PointerCaptureLost">
                    <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#FFFFFFFF"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Canvas>
        </Grid>

        
    </Grid>
</Window>
